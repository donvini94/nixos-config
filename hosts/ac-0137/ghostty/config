# Theme — Modus with system-follows dark/light
theme = light:modus-vivendi-tinted,dark:modus-vivendi-tinted

# Font
font-family = Iosevka Nerd Font
font-size = 20

# Window
window-padding-x = 8
window-padding-y = 8
window-decoration = true
macos-titlebar-style = tabs
confirm-close-surface = false

# Cursor
cursor-style = bar
cursor-style-blink = false
shell-integration = fish

# Scrollback
scrollback-limit = 10000

# Opacity
background-opacity = 0.9

# Mouse
mouse-hide-while-typing = true
copy-on-select = clipboard

# Shell
command = @fish@

# ── Keybindings ──────────────────────────────────

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+w=close_tab
keybind = cmd+k=next_tab
keybind = cmd+j=previous_tab

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+w=close_surface

# Split navigation (vim-style with cmd+ctrl)
keybind = cmd+ctrl+h=goto_split:left
keybind = cmd+ctrl+j=goto_split:bottom
keybind = cmd+ctrl+k=goto_split:top
keybind = cmd+ctrl+l=goto_split:right

# Split management
keybind = cmd+shift+equal=equalize_splits
keybind = cmd+shift+enter=toggle_split_zoom

# Quick tab switching
keybind = cmd+one=goto_tab:1
keybind = cmd+two=goto_tab:2
keybind = cmd+three=goto_tab:3
keybind = cmd+four=goto_tab:4
keybind = cmd+five=goto_tab:5
