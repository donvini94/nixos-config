// Grants customer servers need in the tailnet policy file. Merge them into the
// tailnet's policy: once any grant exists, everything not granted is denied, so the
// operator's own devices need their grants there too. Customer servers appear only as
// destinations; nothing grants them a connection to anything.
{
  "tagOwners": {
    "tag:customer": ["autogroup:admin"],
    "tag:monitoring": ["autogroup:admin"],
  },
  "grants": [
    // The operator: SSH, the n8n editor and the Hermes dashboard.
    {"src": ["autogroup:admin"], "dst": ["tag:customer"], "ip": ["22", "25678", "29119"]},
    // Central Prometheus: node exporter and cAdvisor.
    {"src": ["tag:monitoring"], "dst": ["tag:customer"], "ip": ["19100", "18081"]},
  ],
}
