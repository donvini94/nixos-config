{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Host CPU busy",
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "targets": [
        {
          "expr": "100 - avg(rate(node_cpu_seconds_total{host=~\"$host\",mode=\"idle\"}[5m])) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Host memory used",
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "targets": [
        {
          "expr": "(1 - node_memory_MemAvailable_bytes{host=~\"$host\"} / node_memory_MemTotal_bytes{host=~\"$host\"}) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container memory",
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "sum by (name) (container_memory_working_set_bytes{host=~\"$host\",name!=\"\"})",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "n8n AI tokens and tool errors",
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum by (type) (rate(n8n_instance_ai_tokens_total{host=~\"$host\"}[5m]))",
          "legendFormat": "tokens \u00b7 {{type}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(n8n_instance_ai_tool_errors_total{host=~\"$host\"}[5m]))",
          "legendFormat": "tool errors",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk space used",
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{host=~\"$host\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{host=~\"$host\",fstype!~\"tmpfs|overlay\"})",
          "legendFormat": "{{mountpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Critical image vulnerabilities",
      "id": 12,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "security_container_vulnerabilities{host=~\"$host\",severity=\"critical\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "High image vulnerabilities",
      "id": 13,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "security_container_vulnerabilities{host=~\"$host\",severity=\"high\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Container scan failures",
      "id": 14,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "security_container_scan_failures{host=~\"$host\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Container scan age",
      "id": 15,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 172800
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "time() - security_container_scan_timestamp_seconds{host=~\"$host\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Critical vulnerabilities by resident image",
      "id": 16,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "sort_desc(security_container_image_vulnerabilities{host=~\"$host\",severity=\"critical\"} > 0)",
          "instant": true,
          "legendFormat": "{{image}} ({{engine}})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "High vulnerabilities by resident image",
      "id": 17,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "sort_desc(security_container_image_vulnerabilities{host=~\"$host\",severity=\"high\"} > 0)",
          "instant": true,
          "legendFormat": "{{image}} ({{engine}})",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "ai",
    "containers",
    "host"
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(node_uname_info, host)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Host and workload overview",
  "uid": "local-ai-overview",
  "version": 5
}
