# ~/.mbsyncrc — isync (mbsync) configuration.
#
# Active account: Bereit Mailcow. Add another IMAPAccount/Store/Channel for each future mailbox.
# Decrypt the mailbox password from ~/.authinfo.gpg; no secret is stored in this file.

# ── Global defaults ──────────────────────────────────────────────────────
Create     Both
Expunge    Both
SyncState  *

IMAPAccount bereit
Host        mail.istbereit.de
Port        993
User        vincenzo@istbereit.de
PassCmd     "gpg --quiet --no-tty --decrypt ~/.authinfo.gpg | awk '/^machine mail[.]istbereit[.]de login vincenzo@istbereit[.]de password / {print $6; exit}'"
TLSType     IMAPS
TLSVersions +1.2 +1.3
AuthMechs   PLAIN

IMAPStore   bereit-remote
Account     bereit

MaildirStore bereit-local
Subfolders   Verbatim
Path         ~/Maildir/bereit/
Inbox        ~/Maildir/bereit/INBOX

Channel     bereit
Far         :bereit-remote:
Near        :bereit-local:
Patterns    *
