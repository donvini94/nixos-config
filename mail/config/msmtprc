# ~/.msmtprc — msmtp SMTP sender configuration.
#
# Called by mu4e via sendmail. mu4e writes the message and pipes it to
#   msmtp -a <account>  (account chosen per mu4e-context).
#
# Logs to ~/Library/Logs/msmtp.log so you can grep send failures.

# ── Global defaults applied to every account ───────────────────────────
defaults
auth          on
tls           on
tls_starttls  on
tls_trust_file /etc/ssl/cert.pem
logfile       ~/Library/Logs/msmtp.log

# ════════════════════════════════════════════════════════════════════════
# Personal: iCloud (active)
# ════════════════════════════════════════════════════════════════════════
account       icloud
host          smtp.mail.me.com
port          587
from          vincenzo.pace94@icloud.com
user          vincenzo.pace94@icloud.com
passwordeval  "gpg --quiet --no-tty --decrypt ~/.authinfo.gpg | awk '/^machine smtp.mail.me.com/ {print $6; exit}'"

