# ~/.msmtprc — msmtp SMTP sender configuration.
#
# notmuch.el sends through message.el -> msmtp; --read-envelope-from selects
# the account matching the From header when more mailboxes are added.

# ── Global defaults applied to every account ───────────────────────────
defaults
auth          on
tls           on
tls_starttls  on
tls_trust_file /etc/ssl/cert.pem
logfile       ~/Library/Logs/msmtp.log

account       bereit
host          mail.istbereit.de
port          587
from          vincenzo@istbereit.de
user          vincenzo@istbereit.de
passwordeval  "gpg --quiet --no-tty --decrypt ~/.authinfo.gpg | awk '/^machine mail[.]istbereit[.]de login vincenzo@istbereit[.]de password / {print $6; exit}'"

account default : bereit
