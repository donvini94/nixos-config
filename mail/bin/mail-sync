#!/bin/sh
# Mail hub pipeline. Runs on alucard only, every 5 minutes, from the systemd user
# timer in hm-modules/mail-hub.nix. The Mac and dracula never talk IMAP: they are
# muchsync replicas of this host's Maildir + notmuch database (mail-replica-sync).
#
# Pipeline:
#   1. mbsync -a    — two-way IMAP sync; pushes flags and Fcc'd sent mail that
#                     replicas uploaded, pulls new mail
#   2. notmuch new  — index new files; tags them +new +unread per ~/.notmuch-config
#   3. tag rules    — sequential `notmuch tag` invocations, top-to-bottom.
#                     Each rule scopes itself to `tag:new` and either:
#                       - adds a persistent tag (reading)
#                       - strips :new + assigns a terminal state (bulk/sent/inbox/...)
#                     The final rule catches whatever's still :new and tags it inbox.
#   4. compute-state — derive owed/reply + age/* dashboard tags.
#   5. emit-followups — regenerate ~/org/mail-followups.org. This host is the only
#                     writer of mail-derived files in the Syncthing-shared ~/org.
#
# Invariant: one writer at a time on this database. The whole run holds the lock
# that replicas' `muchsync --server` also takes (see mail-replica-sync's -r), so a
# replica sync waits for a tagging pass instead of racing it for the Xapian lock.

set -u
# Linux: home-manager puts packages in the user profile (useUserPackages is off), so
# ~/.nix-profile/bin must be listed; /etc/profiles/per-user covers useUserPackages hosts.
PATH=$HOME/.local/bin:$HOME/.nix-profile/bin:/etc/profiles/per-user/$USER/bin:/opt/homebrew/bin:/run/current-system/sw/bin:/usr/bin:/bin
export PATH

log() { printf '[mail-sync %s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }

# mbsync creates folders inside an account directory, not the directory itself.
mkdir -p "$HOME/.local/state" "$HOME/Maildir/bereit"
exec 9>"$HOME/.local/state/mail-hub.lock"
if ! flock -w 600 9; then
    log "lock busy for 10 minutes, skipping this run"
    exit 1
fi

log "mbsync"
mbsync -a || exit $?

log "notmuch new"
notmuch new

log "tagging"

# Mailbox-specific classification can be added here as business accounts grow.

# ============================================================================
# Universal terminal-state rules (run on both platforms).
# These strip :new so the catch-all below doesn't land them in :inbox.
# ============================================================================

# Industry-reading allowlist — visible in the "Reading" view, not the inbox.
# Runs before the bulk killer so List-Unsubscribe carriers in this list still
# get +reading instead of disappearing into +bulk.
notmuch tag +reading -new -- \
    '(from:compass@sailpoint.com OR from:brighttalk.com OR from:kuppingercole.com OR from:gartner.com) AND tag:new'

# Bulk mail killer (List-Unsubscribe header carriers). The custom-indexed
# LISTUNSUB prefix is defined in ~/.notmuch-config. Query matches on tokens
# inside the unsubscribe URL/mailto — covers ~96% of real bulk mail.
notmuch tag +bulk -new -- \
    '(LISTUNSUB:https OR LISTUNSUB:http OR LISTUNSUB:mailto) AND tag:new'

# Sent-by-me: mail where I am in From: but not in To:.
notmuch tag +sent -new -- \
    'from:vincenzo@istbereit.de AND NOT to:vincenzo@istbereit.de AND tag:new'

# --- Default inbox: everything still tagged :new lands in :inbox -------------

notmuch tag +inbox -new -- 'tag:new'

# --- Dashboard state: compute owed/reply + age/* tags ------------------------
# Runs after the persistent rules so it can see the final state of each
# thread. Clears its own outputs on each run (idempotent).

log "compute-state"
notmuch-compute-state

# --- Org-agenda integration: regenerate ~/org/mail-followups.org -------------

log "emit-followups"
notmuch-emit-followups

log "done"
