#!/bin/sh
# Regenerate ~/org/mail-followups.org from notmuch state.
#
# Output: one TODO heading per thread in `tag:owed/reply` and `tag:s/waiting`,
# linked back to the source message in notmuch. The file is auto-rewritten on
# every mail-sync run — DO NOT edit it by hand, your edits will be lost.
#
# Entries are sorted oldest-first within each section so the most aged items
# float to the top in any agenda view.

set -u
PATH=$HOME/.local/bin:/opt/homebrew/bin:/run/current-system/sw/bin:/usr/bin:/bin
export PATH

OUT=$HOME/org/mail-followups.org
TMP=$(mktemp -t mail-followups.org.XXXXXX)
NOW=$(date +%s)

# Ensure the parent dir exists. On a fresh machine (especially the NixOS
# bootstrap before syncthing has accepted the org folder) this saves the
# script from silently failing at the final mv.
mkdir -p "$(dirname "$OUT")"

# Map an age tag back to a property value the agenda can sort by.
# Lower = more urgent in agenda sort. We bias by recency, then by age bucket.
priority_for_age() {
    # $1 is the colon-joined tag string with '/' already translated to '_'.
    case "$1" in
        *age_old*)   echo "A" ;;
        *age_7d*)    echo "B" ;;
        *age_3d*)    echo "C" ;;
        *age_today*) echo "C" ;;
        *)           echo "C" ;;
    esac
}

emit_thread() {
    tid=$1; queue=$2

    # Pick the timestamp we care about for this queue. Owed/reply ages by
    # *their* last message; waiting ages by *my* last outbound.
    if [ "$queue" = "owed" ]; then
        msg=$(notmuch search --output=messages --sort=newest-first --limit=1 \
              "$tid AND NOT (from:vincenzo.pace94@icloud.com OR from:pace@amiconsult.de)")
    else
        msg=$(notmuch search --output=messages --sort=newest-first --limit=1 \
              "$tid AND (from:vincenzo.pace94@icloud.com OR from:pace@amiconsult.de)")
        [ -z "$msg" ] && msg=$(notmuch search --output=messages --sort=newest-first --limit=1 "$tid")
    fi
    [ -z "$msg" ] && return

    # Strip the leading "id:" prefix that notmuch-search prints.
    msg_id=${msg#id:}

    # Single notmuch show invocation, then pull everything we need from JSON.
    json=$(notmuch show --format=json --body=false --entire-thread=false "$msg")
    ts=$(echo "$json"      | jq -r '.[0][0][0].timestamp')
    from=$(echo "$json"    | jq -r '.[0][0][0].headers.From')
    subject=$(echo "$json" | jq -r '.[0][0][0].headers.Subject')
    # Tag list for the heading. Org-mode only accepts [:alnum:]_@#% in tags,
    # so translate notmuch's '/' separator into '_' (s/waiting → s_waiting).
    # Also drop noise tags that don't help with triage filtering.
    tags=$(notmuch search --output=summary --format=json "$tid" \
           | jq -r '.[0].tags
                    | map(select(. != "unread" and . != "attachment"
                                 and . != "signed" and . != "encrypted"
                                 and . != "replied" and . != "passed"
                                 and . != "flagged" and . != "draft"))
                    | map(gsub("/"; "_"))
                    | join(":")')

    age_days=$(( (NOW - ts) / 86400 ))
    age_label=""
    case "$age_days" in
        0) age_label="today" ;;
        1) age_label="1 day" ;;
        *) age_label="${age_days} days" ;;
    esac

    # Sanitize subject for the heading (strip newlines, collapse whitespace).
    subject_clean=$(printf '%s' "$subject" | tr '\n\r' '  ' | sed 's/  */ /g')
    from_clean=$(printf '%s'    "$from"    | tr '\n\r' '  ' | sed 's/  */ /g')

    # Surface aging via a priority cookie + a tag the agenda can filter on.
    priority=$(priority_for_age "$tags")

    {
        printf '** TODO [#%s] %s    :%s:\n' "$priority" "$subject_clean" "$tags"
        printf '   :PROPERTIES:\n'
        printf '   :MAIL_THREAD: %s\n' "$tid"
        printf '   :MAIL_MSGID:  %s\n' "$msg_id"
        printf '   :AGE_DAYS:    %s\n' "$age_days"
        printf '   :END:\n'
        printf '   - Counterpart :: %s\n' "$from_clean"
        printf '   - Age         :: %s\n' "$age_label"
        printf '   - [[notmuch:id:%s][Open in notmuch]]\n' "$msg_id"
        printf '\n'
    } >> "$TMP"
}

emit_section() {
    title=$1; query=$2; queue=$3

    printf '\n* %s\n' "$title" >> "$TMP"

    # Sort oldest-first so the most-aged item lands at the top of the section.
    threads=$(notmuch search --output=threads --sort=oldest-first "$query")
    if [ -z "$threads" ]; then
        printf '  /No threads./\n' >> "$TMP"
        return
    fi

    for tid in $threads; do
        emit_thread "$tid" "$queue"
    done
}

cat > "$TMP" <<'HEADER'
# -*- mode: org; -*-
#+title: Mail follow-ups
#+filetags: :mail:autogen:
#+startup: overview
#+todo: TODO(t) | DONE(d)

# ============================================================================
# AUTOGENERATED by ~/.local/bin/notmuch-emit-followups
# Regenerated on every mail-sync run (every 5 minutes).
# DO NOT EDIT — your changes WILL be overwritten.
# To act on a thread: open the notmuch link and reply/archive/tag from there.
# ============================================================================
HEADER

printf '#+updated: %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')" >> "$TMP"

emit_section "Owed reply (they sent, you haven't replied)" "tag:owed/reply" "owed"
emit_section "Waiting (you sent, they haven't replied)"    "tag:s/waiting"  "waiting"

mv "$TMP" "$OUT"
echo "[emit-followups] wrote $OUT"
