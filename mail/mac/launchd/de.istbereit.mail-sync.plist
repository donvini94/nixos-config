<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      notmuch replica sync. Runs every 5 minutes and at login.
      Invokes ~/.local/bin/mail-replica-sync, which runs `muchsync alucard`:
      mail and tags come from the alucard mail hub; local tag changes and
      Fcc'd sent mail go back. No IMAP and no GPG here.
    -->
    <key>Label</key>
    <string>de.istbereit.mail-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/vincenzopace/.local/bin/mail-replica-sync</string>
    </array>

    <!-- Sync every 5 minutes -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- Sync immediately when this agent loads (login) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Don't restart on error; just wait for the next interval -->
    <key>KeepAlive</key>
    <false/>

    <!-- Logs (rotate manually if they get large) -->
    <key>StandardOutPath</key>
    <string>/Users/vincenzopace/Library/Logs/mail-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/vincenzopace/Library/Logs/mail-sync.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- muchsync (nix), notmuch (Homebrew) and ssh -->
        <key>PATH</key>
        <string>/etc/profiles/per-user/vincenzopace/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/vincenzopace</string>
        <key>USER</key>
        <string>vincenzopace</string>
    </dict>

    <!-- macOS will not nap this process while it's running -->
    <key>ProcessType</key>
    <string>Background</string>

    <!-- Run at low priority so a sync doesn't fight with Emacs/Chrome -->
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
