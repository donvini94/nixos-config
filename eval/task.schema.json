{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dracula.local/schemas/ai-eval-task-v1.json",
  "title": "Dracula local coding evaluation task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "prompt", "revision", "oracles"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "description": { "type": "string" },
    "prompt": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 7 },
    "timeout_seconds": { "type": "integer", "minimum": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "log_timestamp": { "type": "string", "format": "date-time" },
        "caller": { "type": "string" },
        "model": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "oracles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "name", "command"],
            "properties": {
              "type": { "const": "command" },
              "name": { "type": "string" },
              "command": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "timeout_seconds": { "type": "integer", "minimum": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "name", "rubric"],
            "properties": {
              "type": { "const": "human" },
              "name": { "type": "string" },
              "rubric": { "type": "string" }
            }
          }
        ]
      }
    }
  }
}
