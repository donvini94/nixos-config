{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": false,
  "platformAutomerge": false,
  "dependencyDashboard": true,
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 22-23 * * 1-5"
  ],
  "ignorePaths": [
    "packages/**",
    "coding-agents/packages/**"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "enabledManagers": [
    "docker-compose",
    "github-actions",
    "nix"
  ],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "ai-stack is private; Alucard's lock entry is bumped by hand after pushing it.",
      "matchDepNames": [
        "ai-stack"
      ],
      "enabled": false
    }
  ]
}
