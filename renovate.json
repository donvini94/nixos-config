{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": false,
  "platformAutomerge": false,
  "dependencyDashboard": true,
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 22-23 * * 1-5"
  ],
  "ignorePaths": [
    "packages/**",
    "coding-agents/packages/**"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "enabledManagers": [
    "docker-compose",
    "github-actions",
    "nix"
  ],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "ai-stack is private; Alucard's lock entry is bumped by hand after pushing it.",
      "matchDepNames": [
        "ai-stack"
      ],
      "enabled": false
    },
    {
      "description": "Deliberate commit pin: tapeback's cached CUDA evaluation.",
      "matchDepNames": [
        "tapeback-nixpkgs"
      ],
      "enabled": false
    },
    {
      "description": "Track stable LinuxServer application releases and image rebuilds.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/sonarr",
        "lscr.io/linuxserver/radarr",
        "lscr.io/linuxserver/prowlarr"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-ls(?<revision>\\d+)$"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/bazarr",
        "lscr.io/linuxserver/sabnzbd"
      ],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "description": "Track stable qBittorrent releases and rebuilds within the same libtorrent major; libtorrent minor/patch updates travel with the image build.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/qbittorrent"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)_v(?<compatibility>\\d+)\\.\\d+\\.\\d+-ls(?<build>\\d+)$"
    },
    {
      "description": "Merge non-major updates after three days on green CI. Merging does not deploy; hosts take them at their next rebuild.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Pinned action digests only run in CI, never on a host.",
      "matchManagers": [
        "github-actions"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Stay manual: the VPN path and database engines.",
      "matchPackageNames": [
        "qmcgaw/gluetun",
        "lscr.io/linuxserver/qbittorrent",
        "/postgres/",
        "/mariadb/",
        "/mysql/",
        "/redis/",
        "/valkey/"
      ],
      "automerge": false
    }
  ]
}
