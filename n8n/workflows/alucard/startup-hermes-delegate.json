      "id": "1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c02",
      "name": "Validate request",
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? {};\nconst keys = Object.keys(body).sort();\nconst expected = ['correlation_id', 'prompt'];\nconst shapeOk = keys.length === expected.length && keys.every((k, i) => k === expected[i]);\nconst idOk = typeof body.correlation_id === 'string' && /^[A-Za-z0-9_-]{1,64}$/.test(body.correlation_id);\nconst promptOk = typeof body.prompt === 'string' && body.prompt.trim().length > 0;\nconst valid = shapeOk && idOk && promptOk;\nconst reason = !shapeOk\n  ? 'body must contain exactly correlation_id and prompt'\n  : !idOk\n    ? 'correlation_id must match [A-Za-z0-9_-]{1,64}'\n    : !promptOk\n      ? 'prompt must be a non-empty string'\n      : '';\nreturn [{ json: { valid, reason, correlation_id: body.correlation_id ?? null, prompt: body.prompt ?? null } }];"
      },
