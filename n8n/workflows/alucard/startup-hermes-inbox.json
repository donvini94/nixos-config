      "name": "Validate message",
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? {};\nconst keys = Object.keys(body).sort();\nconst expected = ['correlation_id', 'kind', 'payload'];\nconst shapeOk = keys.length === expected.length && keys.every((k, i) => k === expected[i]);\nconst idOk = typeof body.correlation_id === 'string' && /^[A-Za-z0-9_-]{1,64}$/.test(body.correlation_id);\nconst kindOk = body.kind === 'artifact' || body.kind === 'event';\nconst payloadOk = body.payload !== null && typeof body.payload === 'object' && !Array.isArray(body.payload);\nconst valid = shapeOk && idOk && kindOk && payloadOk;\nconst reason = !shapeOk\n  ? 'body must contain exactly correlation_id, kind and payload'\n  : !idOk\n    ? 'correlation_id must match [A-Za-z0-9_-]{1,64}'\n    : !kindOk\n      ? \"kind must be 'artifact' or 'event'\"\n      : !payloadOk\n        ? 'payload must be a JSON object'\n        : '';\nreturn [{ json: { valid, reason, correlation_id: body.correlation_id ?? null, kind: body.kind ?? null, payload: body.payload ?? null } }];"
      },
