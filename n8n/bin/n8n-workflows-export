#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
if [[ -n "${1:-}" ]]; then
  destination="$1"
elif [[ -n "${N8N_WORKFLOW_EXPORT_DIR:-}" ]]; then
  destination="$N8N_WORKFLOW_EXPORT_DIR"
elif [[ -w "$script_dir/.." ]]; then
  destination="$script_dir/../exports/$timestamp"
else
  destination="${XDG_STATE_HOME:-"$HOME/.local/state"}/n8n/exports/$timestamp"
fi
container="${N8N_CONTAINER_NAME:-n8n}"

if ! docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null | grep -qx true; then
  echo "n8n container is not running: $container" >&2
  exit 1
fi
if [[ -e "$destination" ]] && find "$destination" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
  echo "refusing to overwrite non-empty destination: $destination" >&2
  exit 1
fi

host_tmp="$(mktemp -d)"
container_dir="/tmp/n8n-workflow-export-$$"
cleanup() {
  docker exec "$container" rm -rf -- "$container_dir" >/dev/null 2>&1 || true
  rm -rf -- "$host_tmp"
}
trap cleanup EXIT

docker exec "$container" mkdir -p -- "$container_dir"
docker exec "$container" n8n export:workflow --backup --output="$container_dir"

mapfile -t exported_names < <(
  docker exec "$container" sh -c \
    'find "$1" -maxdepth 1 -type f -name "*.json" -exec basename {} \;' \
    sh "$container_dir" | sort
)
for exported_name in "${exported_names[@]}"; do
  if [[ "$exported_name" == */* || "$exported_name" == "." || "$exported_name" == ".." ]]; then
    echo "refusing unsafe exported filename: $exported_name" >&2
    exit 1
  fi
  docker exec "$container" sh -c 'cat "$1"' sh "$container_dir/$exported_name" \
    > "$host_tmp/$exported_name"
done

mapfile -d '' workflow_files < <(find "$host_tmp" -maxdepth 1 -type f -name '*.json' -print0 | sort -z)
if [[ "${#workflow_files[@]}" -eq 0 ]]; then
  echo "n8n contains no workflows; nothing was written"
  exit 0
fi
for workflow_file in "${workflow_files[@]}"; do
  jq empty "$workflow_file" >/dev/null
done

mkdir -p -- "$destination"
cp -- "${workflow_files[@]}" "$destination/"
echo "Exported ${#workflow_files[@]} workflow(s) to $destination"
