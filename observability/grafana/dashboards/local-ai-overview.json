{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat", "title": "Host CPU busy", "id": 1,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [{ "expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100", "refId": "A" }]
    },
    {
      "type": "stat", "title": "Host memory used", "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [{ "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "refId": "A" }]
    },
    {
      "type": "stat", "title": "GPU utilization", "id": 3,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [{ "expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "GPU {{gpu}}", "refId": "A" }]
    },
    {
      "type": "stat", "title": "GPU framebuffer used", "id": 4,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "decmbytes" } },
      "targets": [{ "expr": "DCGM_FI_DEV_FB_USED", "legendFormat": "GPU {{gpu}}", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "AI requests by caller and model", "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "expr": "sum by (caller, model) (rate(ai_ingress_requests_total[5m]))", "legendFormat": "{{caller}} · {{model}}", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "AI tokens by caller and model", "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "sum by (caller, model) (rate(ai_ingress_prompt_tokens_total[5m]))", "legendFormat": "input · {{caller}} · {{model}}", "refId": "A" },
        { "expr": "sum by (caller, model) (rate(ai_ingress_completion_tokens_total[5m]))", "legendFormat": "output · {{caller}} · {{model}}", "refId": "B" }
      ]
    },
    {
      "type": "timeseries", "title": "AI latency and time to first token", "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "sum by (caller, model) (rate(ai_ingress_latency_seconds_sum[5m])) / sum by (caller, model) (rate(ai_ingress_latency_seconds_count[5m]))", "legendFormat": "latency · {{caller}} · {{model}}", "refId": "A" },
        { "expr": "sum by (caller, model) (rate(ai_ingress_ttft_seconds_sum[5m])) / sum by (caller, model) (rate(ai_ingress_ttft_seconds_count[5m]))", "legendFormat": "TTFT · {{caller}} · {{model}}", "refId": "B" }
      ]
    },
    {
      "type": "timeseries", "title": "Container memory", "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "expr": "sum by (name) (container_memory_working_set_bytes{name!=\"\"})", "legendFormat": "{{name}}", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "n8n AI tokens and tool errors", "id": 9,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "sum by (type) (rate(n8n_instance_ai_tokens_total[5m]))", "legendFormat": "tokens · {{type}}", "refId": "A" },
        { "expr": "sum(rate(n8n_instance_ai_tool_errors_total[5m]))", "legendFormat": "tool errors", "refId": "B" }
      ]
    },
    {
      "type": "timeseries", "title": "Disk space used", "id": 10,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [{ "expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"})", "legendFormat": "{{mountpoint}}", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "AI cost by caller and model (provider actual)", "id": 11,
      "description": "Provider-reported spend only. Never add this to the list-price estimate panel: both describe the same traffic, so summing them double-counts.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "fixed", "fixedColor": "green" } } },
      "targets": [{ "expr": "sum by (caller, model) (increase(ai_ingress_cost_usd_total[5m]))", "legendFormat": "actual · {{caller}} · {{model}}", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "AI cost by caller and model (list-price estimate)", "id": 18,
      "description": "Registry list prices applied to observed token counts. Diverges from the actual panel when the provider discounts, caches, or the price map is stale; a flat zero here means the model is missing from LLAMA_PRICE_MAP.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "fixed", "fixedColor": "orange" } } },
      "targets": [{ "expr": "sum by (caller, model) (increase(ai_ingress_estimated_cost_usd_total[5m]))", "legendFormat": "estimate · {{caller}} · {{model}}", "refId": "A" }]
    },
    {
      "type": "stat", "title": "Critical image vulnerabilities", "id": 12,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 36 },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "targets": [{ "expr": "security_container_vulnerabilities{severity=\"critical\"}", "refId": "A" }]
    },
    {
      "type": "stat", "title": "High image vulnerabilities", "id": 13,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 36 },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } } },
      "targets": [{ "expr": "security_container_vulnerabilities{severity=\"high\"}", "refId": "A" }]
    },
    {
      "type": "stat", "title": "Container scan failures", "id": 14,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 36 },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "targets": [{ "expr": "security_container_scan_failures", "refId": "A" }]
    },
    {
      "type": "stat", "title": "Container scan age", "id": 15,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 172800 }] } } },
      "targets": [{ "expr": "time() - security_container_scan_timestamp_seconds", "refId": "A" }]
    },
    {
      "type": "bargauge", "title": "Critical vulnerabilities by resident image", "id": 16,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true },
      "targets": [{ "expr": "sort_desc(security_container_image_vulnerabilities{severity=\"critical\"} > 0)", "instant": true, "legendFormat": "{{image}} ({{engine}})", "refId": "A" }]
    },
    {
      "type": "bargauge", "title": "High vulnerabilities by resident image", "id": 17,
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 40 },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } } },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true },
      "targets": [{ "expr": "sort_desc(security_container_image_vulnerabilities{severity=\"high\"} > 0)", "instant": true, "legendFormat": "{{image}} ({{engine}})", "refId": "A" }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["ai", "containers", "host"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "AI and machine overview",
  "uid": "local-ai-overview",
  "version": 5
}
